# Secret-free production configuration template.
#
# This file is an example. Do not deploy it with these placeholder values.
# Do not rename it to .env. The application calls load_dotenv(), which
# reads a file named .env and does not replace variables already set in
# the process. The repository gitignore ignores .env and does not ignore
# this example. Put real values in the host's secret store, not in git.
#
# PostgreSQL 16 is the major version exercised by the backend tests and
# the isolated recovery proof. Startup parses configuration and does not
# connect or migrate. Production readiness requires PostgreSQL major
# version 16. That server must be provisioned separately.

SKAPE_ENV=production

# PostgreSQL URL with a database name. Replace every part. The placeholder
# host is not a production server.
DATABASE_URL=postgresql+psycopg2://replace-user:replace-password@db.example.invalid:5432/replace-database

# HS256 signing secret. Generate a unique value with a cryptographically
# secure random generator. The secret must be at least 32 characters.
# The placeholder below is shorter than 32 characters, so startup rejects
# it if it is left unchanged.
SECRET_KEY=replace-with-generated-secret
ALGORITHM=HS256

# Optional. Unset uses 30 minutes. A set value must be an integer.
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated HTTPS browser origins. No wildcards. The placeholder
# is not a deployed application.
SKAPE_CORS_ORIGINS=https://app.example.invalid

# Production rejects a value that enables /docs, /redoc, or /openapi.json.
# Unset also leaves those endpoints disabled. Keep this false.
SKAPE_ENABLE_API_DOCS=false

# Optional PostgreSQL pool settings for the application engine only.
# Unset values use the defaults shown. Alembic does not use these.
# SKAPE_DB_POOL_SIZE=5
# SKAPE_DB_MAX_OVERFLOW=5
# SKAPE_DB_POOL_TIMEOUT_SECONDS=30
# SKAPE_DB_POOL_RECYCLE_SECONDS=300
# SKAPE_DB_STATEMENT_TIMEOUT_SECONDS=30
